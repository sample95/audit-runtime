# Byte-compiled / cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Environments
.env
.venv/
venv/
env/

# Editors
.vscode/
.idea/

# Trained models / checkpoints — see README.md Pre-trained models section.
# *.zip/*.pth/*.pb match at any depth (no leading slash), so this already
# excludes every nested checkpoint under models/*/ without needing a blanket
# "models/" rule — which would also hide models/README.md and
# models/make_sha256sums.sh (non-binary, should be tracked).
*.pth
*.zip
*.pb
*_vecnormalize.pkl

# Generated run output — not committed, regenerated by running the framework
results/
logs/
runs/
data/
outputs/
*.log

# Stray trash-can directories that have ended up inside this working tree before
.Trash-1000/
